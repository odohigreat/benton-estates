# Passcode for /admin; also signs admin session tokens. Required in production.
ADMIN_SECRET_KEY=

# Supabase Project URL (Project Settings > Data API)
SUPABASE_URL=
# Server-only secret API key (Project Settings > API Keys). Never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy service-role key is also supported instead of SUPABASE_SECRET_KEY:
# SUPABASE_SERVICE_ROLE_KEY=
